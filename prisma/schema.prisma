generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique
  phone          String?  @unique
  password       String
  name           String
  role           String   @default("PATIENT") // PATIENT | DOCTOR | SECRETARY | ADMIN
  avatar         String?
  status         String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctorProfile     DoctorProfile?
  patientProfile    PatientProfile?
  secretaryProfile  SecretaryProfile?
  patientAppts      Appointment[]    @relation("PatientAppointments")
  doctorAppts       Appointment[]    @relation("DoctorAppointments")
  messages          ChatMessage[]
  reviewsGiven      Review[]         @relation("ReviewerReviews")
  reviewsReceived   Review[]         @relation("ReceivedReviews")
  blogPosts         BlogPost[]
  notifications     Notification[]
  patientConversations Conversation[] @relation("PatientConversations")
  doctorConversations  Conversation[] @relation("DoctorConversations")
}

model Specialty {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  icon        String?
  description String?
  doctors     DoctorProfile[]
}

model DoctorProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId  String?
  specialty    Specialty? @relation(fields: [specialtyId], references: [id])
  bio          String?
  education    String?
  experience   Int     @default(0)
  price        Int     @default(300000) // حضوری - تومان
  onlinePrice  Int     @default(200000) // آنلاین - تومان
  licenseNo    String?
  verified     Boolean @default(false)
  rating       Float   @default(0)
  reviewsCount Int     @default(0)
  city         String?
  schedules    Schedule[]
}

model PatientProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId String?
  birthDate  String?
  gender     String?
  address    String?
  bloodType  String?
  allergies  String?
}

model SecretaryProfile {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicName String?
  phone      String?
}

model Schedule {
  id          String  @id @default(cuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  weekday     Int     // 0=شنبه .. 6=جمعه
  startTime   String  @default("09:00")
  endTime     String  @default("17:00")
  slotMinutes Int     @default(30)
  isActive    Boolean @default(true)
}

model Appointment {
  id        String   @id @default(cuid())
  code      String   @unique
  patientId String
  patient   User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  date      String   // "2026-10-15" میلادی ذخیره، نمایش شمسی
  time      String   // "10:30"
  type      String   @default("IN_PERSON") // IN_PERSON | ONLINE
  status    String   @default("PENDING")  // PENDING | CONFIRMED | COMPLETED | CANCELLED
  price     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  payment   Payment?
  review    Review?
  prescription Prescription?
}

model Payment {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Int
  method        String   @default("GATEWAY")
  status        String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  trackingCode  String   @unique
  paidAt        DateTime?
}

model Prescription {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  items         String  @default("[]") // JSON: [{drug, dosage, note}]
  advice        String?
  createdAt     DateTime @default(now())
}

model Review {
  id            String  @id @default(cuid())
  patientId     String
  patient       User    @relation("ReviewerReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User    @relation("ReceivedReviews", fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  status        String  @default("APPROVED") // PENDING | APPROVED | REJECTED
  createdAt     DateTime @default(now())
}

model Conversation {
  id           String   @id @default(cuid())
  patientId    String
  patient      User     @relation("PatientConversations", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       User     @relation("DoctorConversations", fields: [doctorId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now())
  messages     ChatMessage[]
}

model ChatMessage {
  id             String  @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           String  @default("TEXT") // TEXT | SYSTEM
  createdAt      DateTime @default(now())
  readAt         DateTime?
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  cover     String?  // gradient token
  category  String   @default("عمومی")
  tags      String?  // JSON array
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  published Boolean  @default(false)
  views     Int      @default(0)
  readTime  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
